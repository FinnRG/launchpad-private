<VirtualHost *:443>
{% if frontend_proxy_protocol_enabled %}
    # Log real client IP from the upstream LB's PROXY protocol header needed for PS7.
    <IfModule mod_remoteip.c>
        RemoteIPProxyProtocol On
    </IfModule>
{% endif %}
    ServerName wildcard.{{ restricted_domain_librarian }}
    ServerAlias *.{{ restricted_domain_librarian }}

    SSLEngine on
{%- if use_per_vhost_certificate %}
    SSLCertificateFile /etc/ssl/certs/{{ restricted_domain_librarian }}.crt
    SSLCertificateKeyFile /etc/ssl/private/{{ restricted_domain_librarian }}.key
{%- if ssl_chain_required %}
    SSLCertificateChainFile /etc/ssl/certs/{{ restricted_domain_librarian }}_chain.crt
{%- endif %}
{%- else %}
    SSLCertificateFile /etc/ssl/certs/{{ domain_librarian }}.crt
    SSLCertificateKeyFile /etc/ssl/private/{{ domain_librarian }}.key
{%- if ssl_chain_required %}
    SSLCertificateChainFile /etc/ssl/certs/{{ domain_librarian }}_chain.crt
{%- endif %}
{%- endif %}

    CustomLog /var/log/apache2/{{ domain_librarian }}-access.log combined
    ErrorLog /var/log/apache2/{{ domain_librarian }}-error.log

    # Make build log files auto-decompress and be viewable from the browser.
    <Location ~ ".*/buildlog_[^/]*\.txt\.gz">
        AddEncoding x-gzip gz
    </Location>

    SetEnv force-proxy-request-1.0 1

    ProxyRequests off
    <Proxy *>
        Require all granted
    </Proxy>

{%- if restricted_librarian_abuse_mitigation %}
{% import "vhosts/abuse-rules.conf.j2" as abuse with context %}
{{- abuse.abuse_rules(rewrite_engine=true) }}
{%- endif %}

    ProxyPreserveHost on
    # nocanon per https://portal.admin.canonical.com/C42560 to avoid
    # problems with Launchpad's handling of e.g. %2B.
    ProxyPass / balancer://cached-launchpad-librarian-download/ nocanon
    ProxyPassReverse / balancer://cached-launchpad-librarian-download/

    <Location />
        Header set Cache-Control "max-age=604800"
    </Location>
</VirtualHost>

