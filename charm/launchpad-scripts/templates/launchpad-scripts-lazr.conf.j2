# Public configuration data.  The contents of this file may be freely shared
# with developers if needed for debugging.

# A schema's sections, keys, and values are automatically inherited, except
# for '.optional' sections.  Update this config to override key values.
# Values are strings, except for numbers that look like ints.  The tokens
# true, false, and none are treated as True, False, and None.

{% from "macros.j2" import opt -%}

[meta]
extends: ../launchpad-db-lazr.conf

[checkwatches]
batch_query_threshold: {{ checkwatches_batch_query_threshold }}
xmlrpc_url: http://{{ domain_xmlrpc_private }}:{{ port_xmlrpc }}/bugs

[codehosting]
{{- opt("internal_branch_by_id_root", internal_branch_by_id_root) }}

[commitment_tracker]
base_url: {{ commitment_tracker_base_url }}
timeout: {{ commitment_tracker_timeout }}

[launchpad]
{{- opt("logparser_max_parsed_lines", logparser_max_parsed_lines) }}

[launchpad_session]
database: {{ db_session }}
dbuser: {{ db_session_user }}

[librarianlogparser]
logs_root: {{ librarian_logs_dir }}/for_parsing

[malone]
debbugs_db_location: {{ var_dir }}/debbugs-mirror

[memcache]
servers: {{ memcache_servers }}

{% if cppa_subprojects %}
[IImportVulnerabilityJobSource]
cppa_subprojects: {{ cppa_subprojects }}
{% endif %}

[launchpad_job]
{{- opt("concurrency", celery_workers_concurrency_launchpad_job) }}

[launchpad_job_slow]
{{- opt("concurrency", celery_workers_concurrency_launchpad_job_slow) }}
