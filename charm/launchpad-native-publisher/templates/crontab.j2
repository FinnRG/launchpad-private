TZ=UTC
MAILFROM={{ bounce_address }}
MAILTO={{ cron_mailto }}
LPCONFIG=launchpad-native-publisher

{% if active -%}
*/5 * * * * {{ code_dir }}/cronscripts/process-job-source.py ICraftPublishingJobSource -q --log-file=INFO:{{ logs_dir }}/process-job-source.ICraftPublishingJobSource.log
{% endif -%}

# OOPS amqp
*/15 * * * * run-one {{ code_dir }}/bin/datedir2amqp --exchange oopses --host {{ oops_rabbitmq_host }} --username {{ oops_rabbitmq_username }} --password {{ oops_rabbitmq_password }} --vhost {{ oops_rabbitmq_vhost }} --repo {{ oopses_dir }} --key ""

