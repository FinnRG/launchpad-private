TZ=UTC
MAILFROM={{ bounce_address }}
MAILTO={{ cron_mailto }}

# Catch up with publishing OOPSes that were temporarily spooled to disk due
# to RabbitMQ being unavailable.
*/15 * * * * {{ code_dir }}/bin/datedir2amqp --exchange oopses --host {{ oops_rabbitmq_host }} --username {{ oops_rabbitmq_username }} --password {{ oops_rabbitmq_password }} --vhost {{ oops_rabbitmq_vhost }} --repo {{ oopses_dir }} --key ""

