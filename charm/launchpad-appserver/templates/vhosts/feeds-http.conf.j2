<VirtualHost *:80>
{% if frontend_proxy_protocol_enabled %}
    # Log real client IP from the upstream LB's PROXY protocol header needed for PS7.
    <IfModule mod_remoteip.c>
        RemoteIPProxyProtocol On
    </IfModule>
{% endif %}
    ServerName feeds.{{ domain }}
    ServerAdmin {{ webmaster_email }}
        
    ErrorLog /var/log/apache2/feeds.{{ domain }}-error.log
    CustomLog /var/log/apache2/feeds.{{ domain }}-access.log combined
    LogLevel warn

    Redirect permanent / https://feeds.{{ domain }}/
</VirtualHost>

