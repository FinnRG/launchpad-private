<html
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  metal:use-macro="view/macro:page/main_only"
  i18n:domain="launchpad"
  >
<body>
<tal:head-epilogue metal:fill-slot="head_epilogue">
  <link rel="stylesheet" type="text/css"
        tal:attributes="href
          string:${icingroot}/css/components/archive-edit-dependencies.css" />
</tal:head-epilogue>
<div metal:fill-slot="main">
<div class="top-portlet">

    <div metal:use-macro="context/@@launchpad_form/form">
    <div class="form" metal:fill-slot="widgets">
      <table>
        <tal:primary_dependency
          define="widget nocall:view/widgets/primary_dependencies|nothing"
          condition="widget">
          <metal:widget
            metal:use-macro="context/@@launchpad_form/widget_row" />
        </tal:primary_dependency>
        <tal:primary_components
          define="widget nocall:view/widgets/primary_components|nothing"
          condition="widget">
          <metal:widget
            metal:use-macro="context/@@launchpad_form/widget_row" />
        </tal:primary_components>
        <tr style="height: 2em;">
          <td colspan="2">&nbsp;</td>
        </tr>
        <tr>
          <td colspan="2">
            <h2 i18n:translate="">Dependencies on other PPAs</h2>
          </td>
        </tr>
        <tal:add_dependency
          define="widget nocall:view/widgets/dependency_candidate|nothing"
          condition="widget">
          <metal:widget
            metal:use-macro="context/@@launchpad_form/widget_row" />
        </tal:add_dependency>
        <tr tal:condition="not: view/has_dependencies">
          <td></td>
          <td>
            <p id="empty-dependencies"
            ><i>No dependencies recorded for this PPA yet.</i></p>
          </td>
        </tr>
      <tr tal:condition="view/dependency_items">
          <td colspan="2">
            <p i18n:translate="">
              Change pin priorities or mark dependencies for removal,
              then select &#8220;Save changes&#8221;.
            </p>
            <table class="listing" id="ppa-dependencies"
                   tal:attributes="data-priority-minimum
                     view/pin_priority_settings/minimum;
                     data-priority-maximum
                     view/pin_priority_settings/maximum">
              <caption class="sr-only" i18n:translate="">
                Extra dependencies for this PPA, with their pin priority
                and a per-row removal control.
              </caption>
              <thead>
                <tr>
                  <th scope="col" i18n:translate="">Dependency</th>
                  <th scope="col">
                    <span i18n:translate="">Pin priority</span><span
                      class="help-tip"><button
                        type="button"
                        class="help-trigger"
                        aria-describedby="pin-priority-help"
                        ><span aria-hidden="true">&#9432;</span><span
                          class="sr-only" i18n:translate=""
                          >About pin priority</span></button><span
                        class="help-bubble"
                        role="tooltip"
                        id="pin-priority-help"
                        i18n:translate=""
                        >Controls how APT chooses dependency versions from
                        this PPA relative to Ubuntu and other PPAs. Higher
                        values are preferred. The default is
                        <tal:default_priority
                          i18n:name="default_priority"
                          tal:replace="view/pin_priority_settings/default"
                          >500</tal:default_priority>. Allowed values:
                        <tal:minimum_priority
                          i18n:name="minimum_priority"
                          tal:replace="view/pin_priority_settings/minimum"
                          >-100</tal:minimum_priority> to
                        <tal:maximum_priority
                          i18n:name="maximum_priority"
                          tal:replace="view/pin_priority_settings/maximum"
                          >2000</tal:maximum_priority>.</span></span>
                  </th>
                  <th scope="col" i18n:translate="">Action</th>
                </tr>
              </thead>
              <tbody>
                <tr tal:repeat="item view/dependency_items"
                    class="ppa-dependency-row"
                    tal:attributes="id string:ppa-dependency-${repeat/item/index}">
                  <td class="dependency-name-cell"
                      tal:define="dependency_url item/url|nothing">
                    <!-- Public PPA: normal link. -->
                    <a tal:condition="dependency_url"
                       class="dependency-name"
                       tal:attributes="href dependency_url"
                       tal:content="item/title">Dependency title</a>
                    <!-- Private PPA: no link is rendered, so state why
                         rather than silently degrading to plain text. -->
                    <tal:private condition="not: dependency_url">
                      <span class="private-dependency"
                            tal:attributes="aria-describedby
                              string:private-ppa-help-${repeat/item/index}">
                        <span class="sprite private" aria-hidden="true"></span>
                        <span class="dependency-name"
                              tal:content="item/title">Dependency title</span>
                        <span class="private-badge"
                              i18n:translate="">Private</span>
                      </span>
                      <span class="sr-only"
                            i18n:translate=""
                            tal:attributes="id
                              string:private-ppa-help-${repeat/item/index}">
                        This is a private PPA. You do not have permission to
                        view its page, so no link is available. You can still
                        remove it from this list but not change its pin priority.
                      </span>
                    </tal:private>
                  </td>
                  <td class="pin-priority-cell"
                      tal:define="widget nocall:item/priority_widget|nothing">
                    <tal:priority condition="widget">
                      <div class="message"
                           tal:define="error python:widget.error()"
                           tal:condition="error"
                           tal:content="structure error" />
                      <tal:input replace="structure python:widget()" />
                    </tal:priority>
                  </td>
                  <td class="action-cell">
                    <label class="remove-on-save">
                      <input type="checkbox"
                             class="line-through-when-checked ppa-dependencies"
                             name="field.selected_dependencies"
                             tal:attributes="value item/token;
                                             aria-describedby
                               string:pending-removal-status-${repeat/item/index}" />
                      <span i18n:translate="">Remove on save</span>
                    </label>
                    <!-- Empty on load so the later injection is announced
                         by the polite live region. -->
                    <span class="pending-removal-status"
                          role="status"
                          aria-live="polite"
                          tal:attributes="id
                            string:pending-removal-status-${repeat/item/index}"
                          ></span>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </table>
   </div> <!-- widgets -->
  </div> <!-- launchpad_form -->
<script type="text/javascript">
  LPJS.use("lp.soyuz.archive_edit_dependencies", function(Y) {
      Y.on("domready", function() {
          Y.lp.soyuz.archive_edit_dependencies
              .setup_archive_edit_dependencies();
      });
  });
</script>
</div> <!--top-portlet -->
</div> <!--main -->
</body>
</html>
